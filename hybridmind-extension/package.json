{
  "name": "hybridmind",
  "displayName": "HybridMind: MCP Trust and AI Agent",
  "description": "See every MCP server your AI tools use, and know when one changes. Powered by MCP Steward. Also includes a coding agent that runs on your own API key.",
  "publisher": "hybridmind",
  "version": "2.2.0",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0d0d0d",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/itheroservices-hub/hybridmind.git"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "ai",
    "autonomous agent",
    "multi-agent",
    "artificial intelligence",
    "llm",
    "gpt",
    "claude",
    "gemini",
    "deepseek",
    "openrouter",
    "code assistant",
    "code generation",
    "agentsync",
    "byok",
    "mcp",
    "copilot",
    "agents",
    "productivity",
    "mcp security",
    "model context protocol",
    "mcp servers",
    "tool poisoning",
    "mcpsteward"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && tsc -p tsconfig.test.json && node test/create-vscode-shim.js",
    "test": "mocha \"test-out/test/**/*.test.js\"",
    "lint": "eslint src --ext ts",
    "package": "vsce package",
    "precompile": "tsc -p ../packages/ontology-core"
  },
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hybridmind",
          "title": "HybridMind",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "hybridmind": [
        {
          "id": "hybridmind.mcpServers",
          "name": "MCP Servers",
          "contextualTitle": "HybridMind MCP Servers"
        },
        {
          "type": "webview",
          "id": "hybridmind.chatView",
          "name": "Chat",
          "icon": "$(comment-discussion)",
          "contextualTitle": "HybridMind Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "hybridmind.openChat",
        "title": "HybridMind: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "hybridmind.setApiKey",
        "title": "HybridMind: Set API Key (BYOK)",
        "icon": "$(key)"
      },
      {
        "command": "hybridmind.quickChat",
        "title": "HybridMind: Quick Chat"
      },
      {
        "command": "hybridmind.showAgentOutput",
        "title": "HybridMind: Show Agent Output",
        "icon": "$(output)"
      },
      {
        "command": "hybridmind.mcp.refresh",
        "title": "HybridMind: Scan MCP Servers",
        "icon": "$(refresh)"
      },
      {
        "command": "hybridmind.mcp.checkAll",
        "title": "HybridMind: Check All Approved MCP Servers",
        "icon": "$(checklist)"
      },
      {
        "command": "hybridmind.mcp.approve",
        "title": "Approve Current Tools",
        "icon": "$(shield)"
      },
      {
        "command": "hybridmind.mcp.check",
        "title": "Check for Changes",
        "icon": "$(search)"
      },
      {
        "command": "hybridmind.mcp.openConfig",
        "title": "Open Config File"
      }
    ],
    "keybindings": [
      {
        "command": "hybridmind.openChat",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "hybridmind.openChat",
          "when": "true"
        },
        {
          "command": "hybridmind.mcp.approve",
          "when": "false"
        },
        {
          "command": "hybridmind.mcp.check",
          "when": "false"
        },
        {
          "command": "hybridmind.mcp.openConfig",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "hybridmind.mcp.refresh",
          "when": "view == hybridmind.mcpServers",
          "group": "navigation@1"
        },
        {
          "command": "hybridmind.mcp.checkAll",
          "when": "view == hybridmind.mcpServers",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "hybridmind.mcp.approve",
          "when": "view == hybridmind.mcpServers && viewItem == mcpServer.unapproved",
          "group": "inline"
        },
        {
          "command": "hybridmind.mcp.check",
          "when": "view == hybridmind.mcpServers && viewItem == mcpServer.approved",
          "group": "inline"
        },
        {
          "command": "hybridmind.mcp.check",
          "when": "view == hybridmind.mcpServers && viewItem == mcpServer.approved",
          "group": "trust@1"
        },
        {
          "command": "hybridmind.mcp.approve",
          "when": "view == hybridmind.mcpServers && viewItem =~ /^mcpServer\\./",
          "group": "trust@2"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "HybridMind",
      "properties": {
        "hybridmind.licenseKey": {
          "type": "string",
          "default": "",
          "description": "HybridMind Pro license key. Get yours at https://hybridmind.dev/pricing"
        },
        "hybridmind.openrouterApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "**Deprecated setting.** Use the `HybridMind: Set API Key (BYOK)` command instead, which stores your key in VS Code's encrypted SecretStorage rather than here in plaintext. If you have never run that command, a key entered here is used once on next activation and then migrated to SecretStorage automatically; after that migration this setting has no effect."
        },
        "hybridmind.modelSelection.mode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "manual",
            "template"
          ],
          "description": "Model selection mode: auto (smart selection), manual (user picks), template (predefined chains)"
        },
        "hybridmind.modelSelection.defaultTemplate": {
          "type": "string",
          "default": "coding-standard",
          "enum": [
            "coding-standard",
            "coding-premium",
            "coding-budget",
            "research-deep",
            "review-comprehensive",
            "quick-fix"
          ],
          "description": "Default chain template to use in template mode"
        },
        "hybridmind.modelSelection.customChain": {
          "type": "object",
          "default": {},
          "description": "Custom model chain configuration (role -> model mapping)"
        },
        "hybridmind.ui.theme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "description": "UI theme preference"
        },
        "hybridmind.ui.compactMode": {
          "type": "boolean",
          "default": false,
          "description": "Use compact UI layout"
        },
        "hybridmind.ui.showModelBadges": {
          "type": "boolean",
          "default": true,
          "description": "Show tier badges on model selectors"
        },
        "hybridmind.userApiProvider": {
          "type": "string",
          "default": "",
          "markdownDescription": "**Deprecated setting.** Use the `HybridMind: Set API Key (BYOK)` command instead, which stores your provider and key in VS Code's encrypted SecretStorage rather than here in plaintext. Not read after the one-time migration to SecretStorage completes."
        },
        "hybridmind.userApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "**Deprecated setting.** Use the `HybridMind: Set API Key (BYOK)` command instead, which stores your key in VS Code's encrypted SecretStorage rather than here in plaintext. Not read after the one-time migration to SecretStorage completes."
        },
        "hybridmind.cloudUrl": {
          "type": "string",
          "default": "",
          "description": "HybridMind Cloud (optional): Supabase project URL. Leave empty to disable Cloud Pro sign-in/sync entirely -- BYOK works fully without this."
        },
        "hybridmind.cloudAnonKey": {
          "type": "string",
          "default": "",
          "description": "HybridMind Cloud (optional): Supabase anon/publishable key. This is meant to be public -- Row Level Security on the server is what actually protects data, not secrecy of this value."
        },
        "hybridmind.cloudCheckoutUrl": {
          "type": "string",
          "default": "",
          "description": "HybridMind Cloud (optional): Stripe Checkout link for HybridMind Pro. Leave empty until the Stripe product/price has been created and a checkout link generated."
        }
      }
    }
  },
  "dependencies": {
    "@hybridmind/local-runtimes": "file:../packages/local-runtimes",
    "@hybridmind/ontology-core": "file:../packages/ontology-core",
    "@supabase/supabase-js": "^2.45.0",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "mcpsteward": "0.1.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.5",
    "@types/vscode": "^1.108.0",
    "cross-env": "^10.1.0",
    "mocha": "^11.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "serialize-javascript": "^7.1.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "HybridMind can run commands and edit files, and its MCP Servers view starts configured MCP servers on request, so it stays off until you trust the workspace."
    }
  }
}
