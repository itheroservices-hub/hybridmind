# Exclude source files - only ship compiled code
src/**
*.ts
tsconfig.json
.eslintrc.json

# Exclude environment files
.env
.env.*
*.env

# Exclude development dependencies
node_modules/@types/**
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/*.md
node_modules/**/*.txt
node_modules/**/LICENSE
node_modules/**/CHANGELOG.md

# Exclude build artifacts
.vscode-test/**
coverage/**
*.vsix

# Exclude git files
.git/**
.gitignore
.gitattributes

# Exclude development files
.vscode/**
!.vscode/launch.json
.editorconfig
webpack.config.js
tsup.config.js

# Exclude temp/dev scripts not needed in package
rewrite-sidebar-ui.js
TEST_FILE.js
TEST_FILE.js.map
check-html.js
check-html2.js
check-state.js
test-workspace/**
scripts/**

# mcpsteward lists TypeScript as an optional peer, used only by its `migrate`
# command, which HybridMind never calls. Without this, vsce treats it as a
# production dependency and ships all 23 MB of it.
node_modules/typescript/**

# node_modules is NOT excluded wholesale. vsce does not bundle: it packages
# production dependencies from node_modules as they are, so excluding the
# directory ships an extension that cannot load (out/agents/agentClient.js
# requires axios at startup). The narrower node_modules rules above still trim
# tests, docs and type definitions from those dependencies.

# Exclude documentation that's not needed in package
docs/**
examples/**
*.log
AGENTIC_GUIDE.md
PROTOCOL_SYSTEM.md
SYSTEM_PROMPTS.md
SYSTEM_PROMPT_INTEGRATION.md

# Development and server-side files that are not part of the extension
test/**
test-out/**
tsconfig.test.json
.github/**
supabase/**
